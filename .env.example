# Vertex AI Configuration
# Path to your Vertex AI service account JSON key file
# Get your credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
VERTEX_AI_CREDENTIALS_PATH=vertex-gemini-api-key.json
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# Database Configuration
# Path to SQLite database file for storing inference logs
# Default: ./storage/inference.db
INFERENCE_DB_PATH=./storage/inference.db
